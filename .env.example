# ============================================================
# KONFIGURASI SERVER SORTIR FOTO (Scale-Up Edition)
# Salin file ini menjadi .env dan isi dengan nilai yang sesuai
# ============================================================

# Port server (default: 3000)
PORT=3000

# Base URL publik aplikasi (Domain custom produksi tanpa trailing slash)
# WAJIB di Vercel Dashboard agar link WA tidak mengarah ke localhost atau domain *.vercel.app
APP_BASE_URL=https://jadiphoto.web.id
PUBLIC_BASE_URL=https://jadiphoto.web.id

# Secret key untuk JWT - gunakan string random panjang!
JWT_SECRET=ganti_dengan_string_random_yang_sangat_panjang_dan_aman_min64karakter

# ---- VERCEL BLOB STORAGE ----
# Aktifkan di: Vercel Dashboard → project → Storage → Create Blob Store
# Token didapat otomatis, salin ke sini untuk development lokal
BLOB_READ_WRITE_TOKEN=vercel_blob_rw_xxxxxxxxxxxxxxxx

# ---- KONFIGURASI WHATSAPP (Fonnte) ----
# Daftar & dapatkan token di: https://fonnte.com
FONNTE_TOKEN=token_fonnte_anda_disini

# Nomor WhatsApp admin (format: 628xxxx tanpa + atau 0)
# Digunakan untuk notifikasi booking masuk & bukti DP diupload
ADMIN_WHATSAPP=628123456789

# ---- DATABASE ----
# URL koneksi PostgreSQL (Neon atau Supabase)
DATABASE_URL=postgresql://user:password@host/dbname?sslmode=require

# ---- GOOGLE CALENDAR (OAuth2) ----
# Buat di: https://console.cloud.google.com → APIs & Services → Credentials
# Pilih "OAuth 2.0 Client IDs" → Application type: Web application
#
# WAJIB: Daftarkan Authorized redirect URI di Google Cloud Console:
#   https://yourdomain.com/api/google/callback
#
# WAJIB: Set env vars ini di Vercel Dashboard → Settings → Environment Variables
#   (file .env tidak ikut ke Vercel secara otomatis!)
#
# PENTING: GOOGLE_REDIRECT_URI harus SAMA PERSIS di:
#   1. File .env ini / Vercel Dashboard
#   2. Google Cloud Console → Authorized redirect URIs
#   Path yang benar: /api/google/callback  (bukan /auth/google/callback)
GOOGLE_CLIENT_ID=xxxx.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=GOCSPX-xxxxxxxxxxxxxxxx
GOOGLE_REDIRECT_URI=https://yourdomain.com/api/google/callback
