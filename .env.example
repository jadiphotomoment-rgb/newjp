# ============================================================
# KONFIGURASI SERVER SORTIR FOTO (Scale-Up Edition)
# Salin file ini menjadi .env dan isi dengan nilai yang sesuai
# ============================================================

# Port server (default: 3000)
PORT=3000

# Secret key untuk JWT - gunakan string random panjang!
JWT_SECRET=ganti_dengan_string_random_yang_sangat_panjang_dan_aman_min64karakter

# ---- VERCEL BLOB STORAGE ----
# Aktifkan di: Vercel Dashboard → project → Storage → Create Blob Store
# Token didapat otomatis, salin ke sini untuk development lokal
BLOB_READ_WRITE_TOKEN=vercel_blob_rw_xxxxxxxxxxxxxxxx

# ---- KONFIGURASI WHATSAPP (Fonnte) ----
# Daftar & dapatkan token di: https://fonnte.com
FONNTE_TOKEN=token_fonnte_anda_disini

# Nomor WhatsApp admin (format: 628xxxx tanpa + atau 0)
# Digunakan untuk notifikasi booking masuk & bukti DP diupload
ADMIN_WHATSAPP=628123456789

# ---- DATABASE ----
# URL koneksi PostgreSQL (Neon atau Supabase)
DATABASE_URL=postgresql://user:password@host/dbname?sslmode=require
