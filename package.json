{
  "name": "sortir-foto",
  "version": "1.0.0",
  "description": "Aplikasi Perantara Sortir Foto Klien - Drive to WhatsApp Notifier",
  "main": "server.js",
  "scripts": {
    "start": "node server.js",
    "dev": "nodemon server.js",
    "build:css": "tailwindcss -i ./public/css/input.css -o ./public/css/style.css",
    "dev:css": "tailwindcss -i ./public/css/input.css -o ./public/css/style.css --watch",
    "test": "node tests/phase2_auth.test.js && node tests/phase3_audit.test.js && node tests/phase4_approval.test.js && node tests/phase5_rbac.test.js && node tests/phase7_performance_e2e.test.js && node tests/pelunasan_wa.test.js",
    "owner:create": "node scripts/create-owner.js",
    "db:migrate": "node scripts/migrate.js"
  },
  "dependencies": {
    "@vercel/blob": "^2.8.0",
    "bcryptjs": "^2.4.3",
    "dotenv": "^16.4.5",
    "express": "^4.19.2",
    "googleapis": "^173.0.0",
    "jsonwebtoken": "^9.0.2",
    "multer": "^2.2.0",
    "node-cron": "^4.6.0",
    "pg": "^8.22.0",
    "uuid": "^9.0.1"
  },
  "devDependencies": {
    "@tailwindcss/cli": "^4.3.3",
    "nodemon": "^3.1.4",
    "tailwindcss": "^3.4.19"
  },
  "engines": {
    "node": "24.x"
  }
}
